Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /adminapp/

    # Существующие файлы (js, assets, canvaskit) отдаём как есть
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA: остальные пути → index.html
    RewriteRule ^ index.html [L]
</IfModule>
